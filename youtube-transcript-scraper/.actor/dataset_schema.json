{
    "$schema": "https://apify.com/schemas/v1/dataset.ide.json",
    "actorSpecification": 1,
    "title": "YouTube transcripts",
    "fields": {},
    "views": {
        "transcripts": {
            "title": "Transcripts",
            "transformation": {
                "fields": [
                    "type",
                    "videoId",
                    "title",
                    "channel",
                    "language",
                    "isAutoGenerated",
                    "durationSeconds",
                    "wordCount",
                    "text",
                    "publishDate",
                    "viewCount",
                    "url",
                    "error"
                ]
            },
            "display": {
                "component": "table",
                "properties": {
                    "type": {
                        "label": "Type",
                        "format": "text"
                    },
                    "videoId": {
                        "label": "Video ID",
                        "format": "text"
                    },
                    "title": {
                        "label": "Title",
                        "format": "text"
                    },
                    "channel": {
                        "label": "Channel",
                        "format": "text"
                    },
                    "language": {
                        "label": "Lang",
                        "format": "text"
                    },
                    "isAutoGenerated": {
                        "label": "Auto",
                        "format": "boolean"
                    },
                    "durationSeconds": {
                        "label": "Duration (s)",
                        "format": "number"
                    },
                    "wordCount": {
                        "label": "Words",
                        "format": "number"
                    },
                    "text": {
                        "label": "Transcript",
                        "format": "text"
                    },
                    "publishDate": {
                        "label": "Published",
                        "format": "text"
                    },
                    "viewCount": {
                        "label": "Views",
                        "format": "number"
                    },
                    "url": {
                        "label": "URL",
                        "format": "link"
                    },
                    "error": {
                        "label": "Error",
                        "format": "text"
                    }
                }
            }
        }
    }
}